{
  "name": "apex-fusion",
  "version": "1.0.0",
  "description": "Apex Fusion - Student Learning Platform with Cloudflare Workers + Hono",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --config wrangler.local.toml --local",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create apex-fusion-db",
    "db:migrate": "node scripts/run-migrations.js",
    "db:migrate:local": "node scripts/run-migrations.js --local",
    "db:schema": "wrangler d1 execute apex-fusion-db --file=./schema.sql",
    "db:schema:local": "wrangler d1 execute apex-fusion-db --local --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "hono",
    "d1",
    "r2"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.48.0"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "zod": "^4.6.5"
  }
}
